@model LibrarySystem.Models.ViewModels.AuthViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Resetowanie Hasła";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">

        <h2 class="mb-2">Wprowadź nowe hasło </h2>
 
        <form asp-controller="Auth" asp-action="ResetPassword" method="post">

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RepeatPassword" class="form-label"></label>
                <input asp-for="RepeatPassword" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="RepeatPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="ConfirmReset" class="form-check-input" />
                <label asp-for="ConfirmReset" class="form-check-label"></label>
                <span asp-validation-for="ConfirmReset" class="text-danger small d-block"></span>
            </div>

            <button type="submit" id = "submitBtn" class="btn btn-primary w-100 mb-3">
                Zresetuj hasło
            </button>

            <div class="text-center">
                <span class="text-muted">Pamiętasz hasło?</span>
                <a asp-controller="Auth" asp-action="Login" class="text-decoration-none ms-1">Wróć do logowania</a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    <script>
        const checkbox = document.getElementById("ConfirmReset");
        const btn = document.getElementById("submitBtn");

        checkbox.addEventListener("change", function () {
            btn.disabled = !this.checked; 
        });
    </script>
}