@model LibrarySystem.Models.ViewModels.AuthViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Przypomnienie hasła";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">

        <h2 class="mb-2">Nie pamiętasz hasła?</h2>
        <p class="text-muted small mb-4">
            Wprowadź adres e-mail powiązany ze swoim kontem. Prześlemy Ci instrukcję wraz z linkiem do utworzenia nowego hasła.
        </p>

        <form asp-controller="Auth" asp-action="ForgotPassword" method="post">

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="np. jan.kowalski@pwr.edu.pl" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">
                Wyślij link resetujący
            </button>

            <div class="text-center">
                <span class="text-muted">Pamiętasz hasło?</span>
                <a asp-controller="Auth" asp-action="Login" class="text-decoration-none ms-1">Wróć do logowania</a>
            </div>

        </form>

    </div>
</div>
