@model LibrarySystem.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Logowanie";
}
<div class="row justify-content-center mt-lg-5">

    <h2 class="mb-3">Logowanie</h2>
    <form asp-controller="Auth" asp-action="Login" method="post">

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" placeholder="np. jan.kowalski@pwr.edu.pl" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" placeholder="••••••••" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary w-100 mb-3">Zaloguj się</button>

        <div class="text-center">
            <span class="text-muted">Nie masz jeszcze konta?</span>
            <a asp-controller="Auth" asp-action="Register" class="text-decoration-none ms-1">Zarejestruj się</a>
        </div>

    </form>


</div>