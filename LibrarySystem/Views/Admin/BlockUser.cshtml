@model BlockUserViewModel

@{
    ViewData["Title"] = "Blokowanie użytkownika";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="border border-danger rounded p-4 shadow-sm">
            <h2 class="text-danger mb-3">Blokowanie użytkownika</h2>

            <div class="alert alert-warning mb-3">
                Blokujesz konto: <strong>@Model.Username</strong> (@Model.Email).<br />
                Użytkownik nie będzie mógł się logować ani wypożyczać książek.
            </div>

            <form asp-action="BlockUser" method="post">
                
                <div class="mb-3">
                    <label asp-for="Reason" class="form-label fw-bold"></label>
                    <textarea asp-for="Reason" class="form-control" rows="3" placeholder="np. Przetrzymanie książek powyżej 30 dni, brak wpłaty kary..."></textarea>
                    <span asp-validation-for="Reason" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="BlockedUntil" class="form-label fw-bold"></label>
                    <input asp-for="BlockedUntil" class="form-control" type="date" />
                    <span asp-validation-for="BlockedUntil" class="text-danger small"></span>
                    <div class="form-text">Pozostaw puste, jeśli blokada ma być bezterminowa.</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">Potwierdź blokadę</button>
                    <a asp-action="Users" class="btn btn-outline-secondary">Anuluj</a>
                </div>
            </form>
        </div>
    </div>
</div>