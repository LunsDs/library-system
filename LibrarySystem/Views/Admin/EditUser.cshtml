@model EditUserViewModel

@{
    ViewData["Title"] = "Edycja użytkownika";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <h2 class="mb-3">Edycja użytkownika</h2>

        <form asp-action="EditUser" method="post">

            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" type="text" />
                <span asp-validation-for="Username" class="text-danger small"></span>
                
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" type ="text"/>
                <span asp-validation-for="Email" class="text-danger small"></span>
                
            </div>

            <div class="mb-3">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" asp-items="Html.GetEnumSelectList<UserRole>()" class="form-select"></select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsApproved" class="form-check-input" type="checkbox" />
                <label asp-for="IsApproved" class="form-check-label fw-bold">Konto aktywowane (zatwierdzone)</label>
                <div class="form-text">Pozwala czytelnikowi na rezerwowanie i wypożyczanie książek.</div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
                <a asp-action="Users" class="btn btn-outline-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>